{
  "name": "issue-parser",
  "description": "Parser for Github, GitLab and Bitbucket issues actions, references and mentions",
  "version": "0.0.0-development",
  "author": "Pierre Vanduynslager (https://github.com/pvdlg)",
  "type": "module",
  "ava": {
    "files": [
      "test/**/*.test.js"
    ]
  },
  "bugs": {
    "url": "https://github.com/semantic-release/issue-parser/issues"
  },
  "dependencies": {
    "lodash.capitalize": "^4.2.1",
    "lodash.escaperegexp": "^4.1.2",
    "lodash.isplainobject": "^4.0.6",
    "lodash.isstring": "^4.0.1",
    "lodash.uniqby": "^4.7.0"
  },
  "devDependencies": {
    "ava": "6.4.1",
    "c8": "12.0.0",
    "lockfile-lint": "5.0.0",
    "ls-engines": "0.9.4",
    "npm-run-all2": "9.0.2",
    "prettier": "3.8.5",
    "publint": "0.3.23"
  },
  "engines": {
    "node": "^18.17 || >=20.6.1"
  },
  "files": [
    "lib",
    "index.js"
  ],
  "homepage": "https://github.com/semantic-release/issue-parser#readme",
  "keywords": [
    "bitbucket",
    "close",
    "duplicate",
    "fix",
    "github",
    "gitlab",
    "issues",
    "mentions",
    "parser",
    "pr",
    "pull-request",
    "references",
    "resolve"
  ],
  "license": "MIT",
  "main": "./index.js",
  "exports": "./index.js",
  "c8": {
    "include": [
      "lib/**/*.js",
      "index.js"
    ],
    "reporter": [
      "json",
      "text",
      "html"
    ],
    "all": true
  },
  "lockfile-lint": {
    "path": "package-lock.json",
    "type": "npm",
    "validate-https": true,
    "allowed-hosts": [
      "npm"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "trailingComma": "es5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/semantic-release/issue-parser.git"
  },
  "scripts": {
    "test": "npm-run-all --print-label --parallel lint:* --parallel test:*",
    "test:unit": "c8 ava -v",
    "lint": "prettier --check \"index.js\" \"lib/**/*.js\" \"test/**/*.js\" \"package.json\"",
    "lint:prettier": "prettier --check \"index.js\" \"lib/**/*.js\" \"test/**/*.js\" \"package.json\"",
    "lint:prettier:fix": "prettier --write \"index.js\" \"lib/**/*.js\" \"test/**/*.js\" \"package.json\"",
    "lint:lockfile": "lockfile-lint",
    "lint:engines": "ls-engines",
    "lint:publish": "publint --strict"
  },
  "renovate": {
    "extends": [
      "github>semantic-release/.github:renovate-config"
    ]
  }
}
